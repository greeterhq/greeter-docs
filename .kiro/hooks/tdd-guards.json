{
  "version": "v1",
  "hooks": [
    {
      "name": "run-related-spec-on-save",
      "description": "Run the unit suite whenever lib/ changes",
      "trigger": "PostFileSave",
      "matcher": "lib/greeter_http/.*\\.rb$",
      "action": {
        "type": "command",
        "command": "source \"$HOME/.rvm/environments/ruby-3.3.5\" && bundle exec rspec --fail-fast --format progress"
      },
      "timeout": 120
    },
    {
      "name": "rubocop-on-save",
      "trigger": "PostFileSave",
      "matcher": "\\.rb$",
      "action": {
        "type": "command",
        "command": "source \"$HOME/.rvm/environments/ruby-3.3.5\" && bundle exec rubocop -A --fail-level E"
      }
    },
    {
      "name": "protect-tests-during-apply",
      "description": "Block agent writes to spec/ and features/ unless I approve",
      "trigger": "PreToolUse",
      "matcher": "fs_write|str_replace|fs_append",
      "action": {
        "type": "command",
        "command": "source \"$HOME/.rvm/environments/ruby-3.3.5\" && bin/guard-test-edits"
      }
    },
    {
      "name": "which-ruby-probe",
      "trigger": "Stop",
      "action": {
        "type": "command",
        "command": "source \"$HOME/.rvm/environments/ruby-3.3.5\" && mkdir -p tmp && ruby -v > tmp/hook-ruby.txt && which bundle >> tmp/hook-ruby.txt"
      },
      "enabled": true
    },
    {
      "name": "full-suite-when-agent-stops",
      "trigger": "Stop",
      "action": {
        "type": "command",
        "command": "source \"$HOME/.rvm/environments/ruby-3.3.5\" && bundle exec rspec && bundle exec cucumber && openspec validate --all --strict --no-interactive"
      },
      "timeout": 300
    }
  ]
}
